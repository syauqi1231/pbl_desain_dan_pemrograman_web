# Copy this file to .env and fill every value marked REQUIRED.
# .env is git-ignored. Never commit real passwords, tokens, or API keys.

# PostgreSQL used by docker-compose.yml (port 5433 on the host).
POSTGRES_USER="boutique"
POSTGRES_PASSWORD=""
POSTGRES_DB="boutique"

# REQUIRED. Keep user, password and database in sync with the values above.
DATABASE_URL="postgresql://USER:PASSWORD@127.0.0.1:5433/boutique?schema=public"

# Public origin. Used for canonical URLs, OpenGraph, sitemap and robots.
APP_URL="http://localhost:3000"

# REQUIRED by prisma/seed.ts. Choose your own local demo credentials.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD=""
CUSTOMER_EMAIL="customer@example.com"
CUSTOMER_PASSWORD=""

# Optional. Hugging Face token for the FASHN Space (improves ZeroGPU quota).
# The Space is public, so try-on still works without a token when quota allows.
HF_TOKEN=""

# Optional. Official FASHN VTON v1.5 Space.
FASHN_SPACE_URL="https://fashn-ai-fashn-vton-1-5.hf.space"

# Optional. Total budget for queueing + inference + download, in milliseconds.
# Lower this to 55000 on hosts that cap requests at 60 seconds.
FASHN_TIMEOUT_MS="100000"

# Optional. Local upload/result directory. Defaults to ./.data
DATA_DIR=""

# Optional. Base URL for Nominatim address lookup. Use your own instance for
# high-traffic deployments. Defaults to https://nominatim.openstreetmap.org
NOMINATIM_URL="https://nominatim.openstreetmap.org"
